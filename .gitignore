# wwwroot/

# Ignore files generated by popular Visual Studio add-ons.
# ReSharper is a .NET productivity tool
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JustCode is a .NET productivity tool
.JustCode

# TeamCity is a build server
_TeamCity*
# Build results
[Dd]ebug/
[Bb]in/
[Oo]bj/
# DotCover is a Code Coverage Tool
*.dotCover

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# DocProject is a documentation generator add-in
DocProject/buildhelp/
DocProject/Help/*.HxT
DocProject/Help/*.HxC
DocProject/Help/*.hhc
DocProject/Help/*.hhk
DocProject/Help/*.hhp
DocProject/Help/Html2

# DocFX is a documentation generator
_docfx/

# StyleCop is a static code analysis tool
StyleCopReport.xml

# Files built by popular Visual Studio add-ons
*.t4
*.t4.log
*.t4.tmp
*.t4host

# Ignore node_modules
node_modules/